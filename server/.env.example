# === Servidor ===
PORT=3001
ADMIN_USER=admin
ADMIN_PASSWORD=123456

# === Provedores de Dados Esportivos ===
FOOTBALL_PROVIDER=worldcup26
FOOTBALL_PROVIDER_FALLBACK=football-data
SPORT_PROVIDER=worldcup26
FOOTBALL_DISABLE_FALLBACK=false

# === Football-Data.org ===
FOOTBALL_DATA_TOKEN=

# === World Cup 2026 API ===
WORLDCUP26_BASE_URL=https://worldcup26.ir
WORLDCUP26_TOKEN=
WORLDCUP26_BACKGROUND_TIMEOUT_MS=25000

# === Cache TTLs (em segundos) ===
FOOTBALL_CACHE_TTL_SECONDS=300
FOOTBALL_CACHE_STALE_TTL_SECONDS=3600
FOOTBALL_LIVE_CACHE_TTL_SECONDS=60
FOOTBALL_LIVE_CACHE_STALE_TTL_SECONDS=600

# === Diretórios ===
NARRAR_DIR=C:\Users\operador\Documents\CHAMADOR DE CAIXA PRO\narrar caixa .mp3
FALLBACK_DIR=C:\chamador_fallback
